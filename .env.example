# Configuration for the team-pulse-reports smart tool.
#
# Copy to ~/.team-pulse/.env -- the one config file this tool reads:
#     mkdir -p ~/.team-pulse && cp .env.example ~/.team-pulse/.env
#
# That is the one location this file is read from, regardless of which
# directory you run the tool in. TEAM_PULSE_DIR moves it.
#
# This file WINS over environment variables -- what you write here is what
# the tool uses. Pass an explicit CLI flag to override it for one command.
#
# Full reference: CONFIGURATION.md

# --- required ---
TEAM_PULSE_URL=

# --- authentication: set a key, OR leave it blank and use `az login` ---
# A key must start with "tp_". When set, it wins over Azure auth.
TEAM_PULSE_KEY=
# Needed for Azure AD auth: the app registration of YOUR Team Pulse server.
TEAM_PULSE_API_APP_ID=

# --- optional ---
# NOTE: TEAM_PULSE_DIR is deliberately not settable here -- it says where this
# file lives, so it is read from the environment only and ignored if set below.
# Models used by `answer`. Defaults ship in the package's default-config.yaml.
TEAM_PULSE_OPENAI_MODEL=
TEAM_PULSE_ANTHROPIC_MODEL=

# --- only for `answer` ---
# Every other capability runs with neither of these set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# HTTP timeout in seconds for calls to the Team Pulse server (default 60).
# Raise it if ask-service times out waiting on the server's LLM.
#TEAM_PULSE_TIMEOUT=60
